# Database (Turso / libSQL)
# For local SQLite development you can use: file:dev.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# GitHub OAuth App (Create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Personal Access Token for GitHub API requests (optional, prevents rate limits)
GITHUB_TOKEN=

# Admin & Session Authentication
ADMIN_PASSWORD=
SESSION_SECRET=
